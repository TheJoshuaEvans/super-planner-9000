{
  "name": "super-planner-9000",
  "version": "0.0.0",
  "description": "A daily planner made just for me! If you don't like it you can just, like, use something else idk get off my back",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart super-planner-9000",
    "pm2:stop": "pm2 stop super-planner-9000",
    "pm2:delete": "pm2 delete super-planner-9000",
    "pm2:logs": "pm2 logs super-planner-9000",
    "pm2:status": "pm2 status"
  },
  "author": "Joshua Evans <thejoshuaevans@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "pm2": "^7.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
